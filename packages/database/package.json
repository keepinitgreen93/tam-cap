{
	"name": "@cap/database",
	"private": true,
	"type": "module",
	"types": "./index.ts",
	"main": "index.js",
	"scripts": {
		"db:generate": "drizzle-kit generate --config=drizzle.cloudflare.config.ts",
		"db:generate:cloudflare": "drizzle-kit generate --config=drizzle.cloudflare.config.ts",
		"db:generate:analytics": "drizzle-kit generate --config=drizzle.analytics.config.ts",
		"test:cloudflare": "node --test cloudflare/database.test.ts cloudflare/atomic.test.ts cloudflare/validation.test.ts",
		"db:generate:cloudflare-concurrency": "node cloudflare/generate-concurrency-migration.ts",
		"db:generate:cloudflare-validation": "node cloudflare/generate-validation-migration.ts",
		"db:push": "drizzle-kit push --config=drizzle.config.ts",
		"db:check": "drizzle-kit check:mysql --config=drizzle.config.ts",
		"db:up": "drizzle-kit up:mysql --config=drizzle.config.ts",
		"db:drop": "drizzle-kit drop --config=drizzle.config.ts",
		"db:studio": "drizzle-kit studio --config=drizzle.config.ts",
		"db:check-integrity": "node scripts/check-migration-integrity.js",
		"drizzle-kit": "bun run dotenv -e ../../.env drizzle-kit --config=drizzle.config.ts",
		"build": "tsdown",
		"db:generate:mysql": "drizzle-kit generate --config=drizzle.config.ts",
		"db:push:mysql": "drizzle-kit push --config=drizzle.config.ts",
		"db:studio:mysql": "drizzle-kit studio --config=drizzle.config.ts",
		"db:check:mysql": "drizzle-kit check:mysql --config=drizzle.config.ts",
		"db:up:mysql": "drizzle-kit up:mysql --config=drizzle.config.ts",
		"db:drop:mysql": "drizzle-kit drop --config=drizzle.config.ts"
	},
	"dependencies": {
		"@cap/env": "workspace:*",
		"@cap/web-domain": "workspace:*",
		"@effect/sql-mysql2": "^0.47.0",
		"@kubiks/otel-drizzle": "^2.1.0",
		"@mattrax/mysql-planetscale": "^0.0.3",
		"@paralleldrive/cuid2": "^2.2.2",
		"@planetscale/database": "^1.19.0",
		"@react-email/components": "^0.1.0",
		"@react-email/render": "1.1.2",
		"@react-email/tailwind": "^1.0.5",
		"@workos-inc/node": "^7.34.0",
		"drizzle-orm": "0.44.6",
		"dub": "^0.64.0",
		"effect": "^3.18.4",
		"mysql2": "^3.15.2",
		"nanoid": "^5.0.4",
		"next": "16.3.0",
		"next-auth": "^4.24.5",
		"react-email": "^4.0.16",
		"resend": "4.6.0",
		"zod": "^3"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "4.20260630.1",
		"@cap/ui": "workspace:*",
		"@cap/utils": "workspace:*",
		"@types/node": "^20.10.0",
		"@types/react": "^19.1.13",
		"@types/react-dom": "19.1.9",
		"dotenv-cli": "latest",
		"drizzle-kit": "0.31.0",
		"miniflare": "4.20260415.0",
		"nodemailer": "^6.9.8",
		"react": "^19.1.1",
		"react-dom": "^19.1.1",
		"react-router-dom": "^6.18.0",
		"tsconfig": "workspace:*",
		"typescript": "^5.8.3"
	},
	"engines": {
		"node": ">=20"
	},
	"exports": {
		".": "./index.ts",
		"./cloudflare": "./cloudflare/index.ts",
		"./cloudflare/analytics": "./cloudflare/analytics/index.ts",
		"./cloudflare/analytics/application": "./cloudflare/analytics/application.ts",
		"./cloudflare/analytics/repository": "./cloudflare/analytics/repository.ts",
		"./cloudflare/analytics/schema": "./cloudflare/analytics/schema.ts",
		"./cloudflare/schema": "./cloudflare/schema.ts",
		"./cloudflare/atomic": "./cloudflare/atomic.ts",
		"./cloudflare/bridge": "./cloudflare/bridge.ts",
		"./cloudflare/application": "./cloudflare/application.ts",
		"./cloudflare/team": "./cloudflare/team.ts",
		"./cloudflare/loops": "./cloudflare/loops.ts",
		"./cloudflare/pro-seat": "./cloudflare/pro-seat.ts",
		"./cloudflare/organization-delete": "./cloudflare/organization-delete.ts",
		"./cloudflare/access": "./cloudflare/access.ts",
		"./cloudflare/desktop-sign-in": "./cloudflare/desktop-sign-in.ts",
		"./cloudflare/transcript-publication": "./cloudflare/transcript-publication.ts",
		"./cloudflare/editing-base": "./cloudflare/editing-base.ts",
		"./cloudflare/transcription-state": "./cloudflare/transcription-state.ts",
		"./cloudflare/ai-generation": "./cloudflare/ai-generation.ts",
		"./transcript-encryption": "./transcript-encryption.ts",
		"./auth/identity": "./auth/identity.ts",
		"./auth/auth-options": "./auth/auth-options.ts",
		"./auth/domain-utils": "./auth/domain-utils.ts",
		"./auth/request-site": "./auth/request-site.ts",
		"./auth/session": "./auth/session.ts",
		"./auth/sso": "./auth/sso.ts",
		"./auth/sso-state": "./auth/sso-state.ts",
		"./schema": "./schema.ts",
		"./video-sharing-default": "./video-sharing-default.ts",
		"./pro-seat-subscription": "./pro-seat-subscription.ts",
		"./loops/*": "./loops/*.ts",
		"./crypto": "./crypto.ts",
		"./helpers": "./helpers.ts",
		"./emails/config": "./emails/config.ts",
		"./emails/*": "./emails/*.tsx",
		"./types": "./types/index.ts",
		"./migrate": "./migrate.ts",
		"./legacy": "./legacy/index.ts",
		"./legacy/schema": "./legacy/schema.ts"
	},
	"publishConfig": {
		"exports": {
			".": "./dist/index.js",
			"./auth/auth-options": "./dist/auth/auth-options.js",
			"./auth/domain-utils": "./dist/auth/domain-utils.js",
			"./auth/request-site": "./dist/auth/request-site.js",
			"./auth/session": "./dist/auth/session.js",
			"./schema": "./dist/schema.js",
			"./crypto": "./dist/crypto.js",
			"./helpers": "./dist/helpers.js"
		}
	}
}
