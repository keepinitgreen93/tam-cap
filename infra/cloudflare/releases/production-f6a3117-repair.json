{
	"name": "tam-cap-app",
	"main": "../runtime-worker.ts",
	"account_id": "c1e96a4b36c73f3cf4ddf50a90082d94",
	"compatibility_date": "2026-10-27",
	"compatibility_flags": ["nodejs_compat"],
	"version_metadata": {
		"binding": "CF_VERSION_METADATA"
	},
	"workers_dev": false,
	"preview_urls": false,
	"triggers": {
		"crons": ["*/15 * * * *"]
	},
	"vars": {
		"CAP_RUNTIME_READY": "true",
		"CAP_MAINTENANCE_ENABLED": "true",
		"CAP_DEPLOYMENT_ID": "f6a31175c04c994992496671c2e0731b70053b4b",
		"CAP_WEB_IMAGE_REVISION": "registry.cloudflare.com/c1e96a4b36c73f3cf4ddf50a90082d94/tam-cap-web@sha256:84c567990b5b873b96e45ddbbc08bff1e30040f81401d6c11ac59c2286a86df0"
	},
	"containers": [
		{
			"class_name": "CapWeb",
			"scheduling_policy": "durable_object",
			"images": {
				"base": {
					"image": "registry.cloudflare.com/c1e96a4b36c73f3cf4ddf50a90082d94/tam-cap-web@sha256:84c567990b5b873b96e45ddbbc08bff1e30040f81401d6c11ac59c2286a86df0"
				}
			}
		},
		{
			"class_name": "CapMedia",
			"scheduling_policy": "durable_object",
			"images": {
				"base": {
					"image": "registry.cloudflare.com/c1e96a4b36c73f3cf4ddf50a90082d94/tam-cap-media@sha256:6835b876b848a7fd598e9cb6b7b70c7f9fe358b378913da29ac9a9ec60e7338b"
				}
			}
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "CAP_WEB",
				"class_name": "CapWeb"
			},
			{
				"name": "CAP_MEDIA",
				"class_name": "CapMedia"
			},
			{
				"name": "CAP_WORKFLOW",
				"class_name": "CapWorkflowStore"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["CapWeb", "CapMedia", "CapWorkflowStore"]
		}
	],
	"queues": {
		"producers": [
			{
				"binding": "WORKFLOW_QUEUE",
				"queue": "tam-cap-workflows"
			}
		],
		"consumers": [
			{
				"queue": "tam-cap-workflows",
				"max_batch_size": 1,
				"max_concurrency": 1,
				"max_retries": 20,
				"dead_letter_queue": "tam-cap-workflows-failed"
			}
		]
	},
	"d1_databases": [
		{
			"binding": "ANALYTICS_DB",
			"database_name": "tam-cap-analytics",
			"database_id": "8d68da95-cf03-49e1-81ff-0ef40007ce6d",
			"migrations_dir": "../../../packages/database/cloudflare/analytics/migrations"
		},
		{
			"binding": "DB",
			"database_name": "tam-cap-metadata",
			"database_id": "f5069a36-ac6e-4d1e-994e-3ba47e9d4545",
			"migrations_dir": "../../../packages/database/cloudflare/migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "DOWNLOADS",
			"bucket_name": "tam-cap-downloads"
		},
		{
			"binding": "VIDEOS",
			"bucket_name": "tam-cap-videos"
		}
	],
	"routes": [
		{
			"pattern": "videos.trulyauthenticmarketing.com",
			"custom_domain": true
		}
	]
}
